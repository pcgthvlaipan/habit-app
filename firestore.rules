rules_version = '2';

// ═══════════════════════════════════════════════════════════════
// Firestore security rules for Habit App
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console → Firestore Database → Rules)
//
// NOTE: v9 adds the shared department list at appConfig/departments.
// It must be publicly readable so the registration screen can show the
// dropdown before the user is signed in. Only admins may edit it —
// mark an account as admin by setting  isAdmin: true  on its
// users/{uid} document in the Firebase console.
// ═══════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Per-user data: a user owns their own doc + habits + logs ──
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      // A user may create/update their own profile, but must never grant
      // themselves admin — only the console (or another admin) can set isAdmin.
      allow create: if isSignedIn() && request.auth.uid == uid
        && !('isAdmin' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid
        && ( !('isAdmin' in request.resource.data)
             || request.resource.data.isAdmin == resource.data.isAdmin );
      allow delete: if false;

      match /habits/{habitId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
        match /logs/{logId} {
          allow read, write: if isSignedIn() && request.auth.uid == uid;
        }
      }
    }

    // ── Shared, admin-managed configuration ──
    match /appConfig/{docId} {
      allow read:  if true;          // needed on the pre-auth registration screen
      allow write: if isAdmin();
    }
  }
}
