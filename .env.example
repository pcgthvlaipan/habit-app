# Copy to .env and fill in (Supabase dashboard → Project Settings → API).
# The frontend only ever uses these two — the anon key is safe to ship,
# Row Level Security is what protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# ── Only needed to run the one-time Firebase → Supabase data migration ──
# scripts/migrate-firebase-to-supabase.mjs  (never bundled into the app)
SUPABASE_SERVICE_ROLE_KEY=YOUR-service-role-key
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
